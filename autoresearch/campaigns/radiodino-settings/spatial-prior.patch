+class _SpatialPrior(nn.Module):
+    def __init__(self, resnet: nn.Module, width: int) -> None:
+        super().__init__()
+        self.resnet = nn.Sequential(
+            resnet.conv1,
+            resnet.bn1,
+            resnet.act1,
+            resnet.maxpool,
+            resnet.layer1,
+            resnet.layer2,
+        )
+        self.down = nn.Conv2d(
+            resnet.layer2[-1].conv3.out_channels, width, kernel_size=3, stride=2
+        )
+        self.norm = _TokenNorm(nn.LayerNorm(width, eps=1e-6))
+        self.register_buffer(
+            "scale",
+            (torch.tensor(IMAGENET_STD) / SPATIAL_PRIOR_STD).view(1, -1, 1, 1),
+            persistent=False,
+        )
+        self.register_buffer(
+            "shift",
+            ((torch.tensor(IMAGENET_MEAN) - SPATIAL_PRIOR_MEAN) / SPATIAL_PRIOR_STD).view(
+                1, -1, 1, 1
+            ),
+            persistent=False,
+        )
+        self.features = None
+
+    def update(self, images: torch.Tensor) -> None:
+        features = self.resnet(images * self.scale + self.shift)
+        features = nn.functional.pad(features, (0, 1, 0, 1))
+        self.features = self.norm(self.down(features))
+
+
+class _PriorInjector(nn.Module):
+    def __init__(self, prior: _SpatialPrior, width: int) -> None:
+        super().__init__()
+        self.source = [prior]
+        self.proj = nn.Linear(width, width)
+        self.gamma = nn.Parameter(torch.zeros(width))
+
+    def forward(self, tokens: torch.Tensor) -> torch.Tensor:
+        prior = self.source[0].features.permute(0, 2, 3, 1)
+        return tokens + (self.proj(prior) * self.gamma).permute(0, 3, 1, 2)
+
