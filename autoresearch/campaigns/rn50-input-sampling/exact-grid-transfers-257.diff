+def cells_to_tokens(values: torch.Tensor) -> torch.Tensor:
+    kernel = values.new_tensor([0.25, 0.5, 0.25])
+    kernel = (kernel[:, None] * kernel)[None, None]
+    cells = values.flatten(0, 1)[:, None]
+    total = F.conv2d(cells, kernel, stride=2, padding=1)
+    weight = F.conv2d(torch.ones_like(cells[:1]), kernel, stride=2, padding=1)
+    return (total / weight)[:, 0].unflatten(0, values.shape[:2])
+
+
+def tokens_to_cells(values: torch.Tensor, shape: tuple[int, int]) -> torch.Tensor:
+    return F.interpolate(values, size=shape, mode="bilinear", align_corners=True)
+
+
 def backbone_mapping_identity(name: str) -> dict:
