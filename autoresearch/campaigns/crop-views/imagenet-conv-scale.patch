+def match_conv_scale(
+    state: dict[str, torch.Tensor], reference: dict[str, torch.Tensor]
+) -> dict[str, torch.Tensor]:
+    scaled = dict(state)
+    for key, weight in state.items():
+        if weight.ndim != 4:
+            continue
+        prefix = key.removesuffix("weight")
+        norm = (
+            prefix.replace("downsample.1.", "downsample.2.")
+            if ".downsample.1." in prefix
+            else prefix.replace("conv", "bn")
+        )
+        factor = (
+            reference[key].double().square().mean().sqrt()
+            / weight.double().square().mean().sqrt()
+        )
+        scaled[key] = (weight.double() * factor).to(weight.dtype)
+        mean, var = state[f"{norm}running_mean"], state[f"{norm}running_var"]
+        scaled[f"{norm}running_mean"] = (mean.double() * factor).to(mean.dtype)
+        scaled[f"{norm}running_var"] = (var.double() * factor.square()).to(var.dtype)
+    return scaled
+
+
 def radimagenet_state_dict(backbone: str) -> dict[str, torch.Tensor]:
     weights = RADIMAGENET_WEIGHTS[backbone]
     path = radimagenet_path(backbone)
